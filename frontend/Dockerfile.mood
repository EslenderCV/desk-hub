# =============================================
# MOOD SERVER FRONTEND BUILD
# Uses Next.js static export (HTML/CSS/JS)
# Copies pre-compiled static assets to /output for nginx
# =============================================

FROM alpine:latest AS output
WORKDIR /output

# Copy the static export directory
COPY out/ .

CMD ["sh", "-c", "echo '[portfolio_app] Static assets ready in /output' && ls -la /output/"]
