# =============================================
# MOOD SERVER FRONTEND BUILD
# Multi-stage build for Next.js static export
# =============================================

# --- Build Stage ---
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# --- Output Stage ---
FROM alpine:latest AS output
WORKDIR /output

# Copy compiled static files from builder stage
COPY --from=builder /app/out ./

CMD ["sh", "-c", "echo '[portfolio_app] Static assets ready in /output' && ls -la /output/"]
