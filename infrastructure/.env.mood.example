####################################################################
# DESK-HUB MOOD SERVER ENVIRONMENT
# Copy this to .env.mood and fill in your secrets
# DO NOT commit .env.mood to version control
####################################################################

# --- API Keys (inject via CI/CD secrets or fill manually) ---
GROQ_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
MAPS_API_KEY=

# --- Port Mappings (adjust if Appwrite conflicts) ---
# External port for the nginx gateway (Appwrite typically uses 80/443)
GATEWAY_PORT=8880
# MQTT broker port (ESP32 connects here)
MQTT_PORT=1883
# MQTT WebSocket port
MQTT_WS_PORT=9001

# --- Pi-hole ---
PIHOLE_BIND_IP=192.168.1.27
PIHOLE_WEB_PORT=8082
PIHOLE_PASSWORD=changeme
